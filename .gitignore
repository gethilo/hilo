# Rust build artifacts
target/

# WarpFS local state — cache files (rebuildable)
.vfs/graph/graph.db
.vfs/graph/graph.db.wal
.vfs/graph/graph.duckdb
.vfs/graph/.last_warm
# GAP-086: per-file parse cache (mtime+size keyed) and the reconcile stamp.
# Rebuildable runtime state — but NOT a wildcard: `.vfs/manifest.yaml` and
# `.vfs/graph/edges.jsonl` are inventory truth and stay tracked.
.vfs/graph/.parse_cache.json
.vfs/graph/.last_reconcile

# GitReins local state
.gitreins/tasks.yaml
.gitreins/history/
.gitreins/config.yaml.bak*
# usage.jsonl: runtime telemetry gitreins appends during local commits (CLN-1)
.gitreins/usage.jsonl

# Python cache
__pycache__/
.pytest_cache/
*.pyc

