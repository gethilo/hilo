export class LiveModeConfigError extends Error {
  readonly code = LIVE_MODE_UNCONFIGURED;
  /** The env knobs that must be set, in the order they are named. */
  readonly missingKnobs: string[];
  constructor(missingKnobs: string[]) {
    super(
      `[config] FATAL: MOCK_MODE=live promises a real availability provider but is missing ` +
        `${missingKnobs.join(", ")} (code ${LIVE_MODE_UNCONFIGURED}). Set them, or run ` +
        `MOCK_MODE=full (in-process mock) / MOCK_MODE=hybrid (real layers where configured).`,
    );
    this.name = "LiveModeConfigError";
    this.missingKnobs = missingKnobs;
  }
}
/**
 * List the env knobs a live-mode deployment is missing. Empty array = the
 * profile can honour its promise.
 *
 * Only `live` is gated: `full` has no real layer to promise, and `hybrid`
 * promises "real where configured", which readiness surfaces per layer.
 */
export function liveModeConfigIssues(config: AppConfig): string[] {
  if (config.mockMode !== "live") return [];
  const issues: string[] = [];
  const amadeus = config.amadeus;
  if (!amadeus || amadeus.environment === "disabled") {
    issues.push("AMADEUS_ENVIRONMENT=test|production");
  }
  if (!amadeus || !amadeus.clientId) issues.push("AMADEUS_CLIENT_ID");
  if (!amadeus || !amadeus.clientSecret) issues.push("AMADEUS_CLIENT_SECRET");
  return issues;
}
/**
 * Startup gate for `MOCK_MODE=live`. Throws ONE error naming EVERY missing
 * knob (not one per boot attempt) so an operator fixes the deployment in a
 * single pass. Called from `src/index.ts` before the port opens — never from
 * `loadConfig()`, which must keep accepting any valid `MOCK_MODE` (a config
 * parser validates shape; the entrypoint owns "may this process serve?").
 */
export function assertLiveModeConfigured(config: AppConfig): void {
  const issues = liveModeConfigIssues(config);
  if (issues.length > 0) {
    throw new LiveModeConfigError(issues);
  }
}
/**
 * Zod schema for AppConfig.
 *
 * Validates raw env vars (all strings) into the typed AppConfig shape.
 * - PORT is coerced to an integer (4000 default) — non-numeric input throws
 *   because it's an unrecoverable startup error.
 * - HOST, NODE_ENV, MOCK_API_URL have plain defaults.
 * - MOCK_MODE is an enum with "full" default — invalid values are logged
 *   and the default is used (recoverable).
 * - API_KEYS is optional; comma-split into an array.
 * - DUCKBRAIN_NAMESPACE is OPTIONAL in the schema (no default) so that
 *   loadConfig() can detect its absence and emit a warning. When set, it
 *   is validated as a non-empty string.
 *
 * Exported so tests can reuse it (e.g. snapshot validation, fixture setup).
 */
export const DEFAULT_PUBLIC_PORT = 4000;
