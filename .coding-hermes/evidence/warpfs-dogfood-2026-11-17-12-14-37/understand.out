func parsePatchArgs(args []string) (root string, positional []string, err error) {
	for i := 0; i < len(args); i++ {
		a := args[i]
		switch {
		case a == "--root" || a == "-root":
			if i+1 >= len(args) || args[i+1] == "" {
				return "", nil, fmt.Errorf("patch: --root requires a directory argument")
			}
