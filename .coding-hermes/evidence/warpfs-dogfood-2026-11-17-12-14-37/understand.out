func collectPatchPaths(patches []patch.FilePatch) []string {
	paths := make([]string, 0, len(patches))
	for _, fp := range patches {
		if fp.OldPath != "" {
			paths = append(paths, fp.OldPath)
		}
		paths = append(paths, fp.Path)
	}
	return paths
}
