internal/patch/devnull.go [provenance=ast_exact, score=1.00]
package patch
// CHT-059 declarations-only seam. This file carries the TYPE vocabulary the
// /dev/null diff forms need so the acceptance tests compile and fail for the
// right reason (assertion failures = RED, not build failure = ERROR). It must
// stay declarations-only: no parsing, no applying, no behavior. The CHT-059
// implementation classifies forms in ParseUnifiedDiff and branches in Apply;
// when that lands, this file may gain doc-comment updates and nothing else.
// Op classifies what a FilePatch does to its target file. The zero value is
// OpEdit (a classic content edit), so every diff parsed before CHT-059 keeps
// meaning what it always meant.
type Op uint8
const (
	// OpEdit applies hunks to an existing file's content (the only form
	// CHT-003 modeled).
	OpEdit Op = iota
	// OpCreate is a creation diff: the old side is /dev/null and the file
	// did not exist before the patch applies.
	OpCreate
	// OpDelete is a deletion diff: the new side is /dev/null and the file
	// is removed when its content matches the hunk's removals exactly.
	OpDelete
	// OpRename is a rename diff: `rename from <old>` / `rename to <new>`
	// metadata names the source (FilePatch.OldPath) and the destination
	// (FilePatch.Path), and the section carries hunks only when the content
	// changed too — a 100%-similarity rename's body is metadata alone
	// (CHT-158). Declarations-only in the RED commit; the parser does not
	// classify this op until CHT-158's implementation lands.
	OpRename
)
// String names the op for error messages and diagnostics.
func (o Op) String() string {
	switch o {
	case OpCreate:
		return "create"
	case OpDelete:
		return "delete"
	case OpRename:
		return "rename"
	default:
		return "edit"
	}
}
// DevNull is the pseudo-path git and diff write where the missing side of a
// creation or deletion diff would name a file.
const DevNull = "/dev/null"


