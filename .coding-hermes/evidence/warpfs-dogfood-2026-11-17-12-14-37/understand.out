internal/patch/cht072_roundtrip_test.go [provenance=ast_exact, score=1.00]
package patch
// CHT-072 round-trip defect pins (RED at filing, foreman-authored 2026-09-23).
//
// The unified-diff GENERATOR (internal/diffgen, CHT-072) is judged by the
// acceptance tests in cmd/toolsd, and its contract says EVERY generated diff
// must round-trip through this package's strict parser + applier. Two apply
// shapes that GNU/difflib-style generators legitimately emit could not:
//
//  1. A "@@ -0,0 +N,C @@" hunk — a pure insertion BEFORE the first line (a
//     creation from an empty old side, or a prepend). The parser records
//     OldStart 0; the edit path computed want = OldStart-1 = -1, which
//     matchAt refuses outright, so the hunk was unappliable at any position.
//  2. An edit that changes the file's TRAILING-NEWLINE state. Apply
//     inherited the original's trailing-newline state unconditionally, so a
//     "\ No newline at end of file" marker on the last "+" line — the only
//     thing that can say the RESULT loses (or, from a no-newline original,
//     KEEPS) the final newline — was silently ignored, and a diff that
//     changes the marker state could never reproduce its target bytes.
//
// Both pins assert the STRICT contract; RED at filing for the honest reason
// that the machinery refused or mis-rendered, never a loosened assertion.
import "testing"
// TestApplyZeroOldStartHunkIsTopInsertion pins the GNU -0,0 shape: OldCount 0
// with OldStart 0 inserts before the first line. The applier must treat a
// zero OldStart as a pre-file insertion (want position 0) instead of
// computing OldStart-1 = -1 and refusing.
func TestApplyZeroOldStartHunkIsTopInsertion(t *testing.T) {
	fp := FilePatch{Path: "f.txt", Hunks: []Hunk{{
		OldStart: 0, OldCount: 0,
		NewStart: 1, NewCount: 2,
		Lines: []string{"+first", "+second"},
	}}}
	got, err := Apply([]byte("old1\nold2\n"), fp, Options{Strict: true})
	if err != nil {
		t.Fatalf("apply: %v", err)
	}
	if want := "first\nsecond\nold1\nold2\n"; got == nil || string(got) != want {
		t.Errorf("top insertion = %q, want %q", got, want)
	}
}
// TestApplyMarkerOnLastPlusChangesTrailingNewline pins that the edit path
// honours a "\ No newline at end of file" marker after the hunk's LAST "+"
// line: the result's final line loses its newline even when the original had
// one. (A marker after a "-" line describes the OLD side and is carried by
// the original's own bytes; the parser already records only the "+" form.)
func TestApplyMarkerOnLastPlusChangesTrailingNewline(t *testing.T) {
	fp := FilePatch{Path: "f.txt", Hunks: []Hunk{{
		OldStart: 1, OldCount: 2,
		NewStart: 1, NewCount: 2,
		Lines:               []string{" a", "-B", "+B"},
		MarkerAfterLastPlus: true,
	}}}
	got, err := Apply([]byte("a\nB\n"), fp, Options{Strict: true})
	if err != nil {
		t.Fatalf("apply: %v", err)
	}
	if want := "a\nB"; got == nil || string(got) != want {
		t.Errorf("apply with marker = %q, want %q (the final newline must be dropped)", got, want)
	}
}
// TestApplyDashLastAtEOFYieldsNewlineTerminated pins the GNU-faithful rule
// for a hunk whose body ends on a "-" removal that consumed the original's
// final line (CHT-072 round-trip; GNU patch measured on all shapes): every
// retained line precedes the removed final line and carried its own newline,
// so the result is newline-terminated — the marker GNU emits after that "-"
// annotates the removed OLD line only and never removes the result's
// newline. This is the shape old-noNL -> new-NL (a newline ADDED to the
// file) round-trips through.
func TestApplyDashLastAtEOFYieldsNewlineTerminated(t *testing.T) {
	// The judge-repro shape (CHT-072 fuzz): old is newline-less, the
	// generated diff carries "-b" last with the marker after it, and the
	// target ("b\n") is newline-terminated.
	fp := FilePatch{Path: "f.txt", Hunks: []Hunk{{
		OldStart: 1, OldCount: 2,
		NewStart: 1, NewCount: 1,
		Lines: []string{" a", "-b"},
	}}}
	got, err := Apply([]byte("a\nb"), fp, Options{Strict: true})
	if err != nil {
		t.Fatalf("apply: %v", err)
	}
	if want := "a\n"; got == nil || string(got) != want {
		t.Errorf("dash-last at EOF = %q, want %q (the retained line carried its newline)", got, want)
	}
}

