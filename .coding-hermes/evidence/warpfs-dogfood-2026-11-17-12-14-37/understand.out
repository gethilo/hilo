func testsTouched(patches []patch.FilePatch) bool {
	for _, fp := range patches {
		if strings.HasSuffix(fp.Path, "_test.go") {
			return true
		}
	}
	return false
}
// protectedPath reports whether a diff path is secret-bearing: basename
// ".env" or ".env.<anything>", extension .pem/.key/.crt/.p12, basename
// "id_rsa"/"id_ed25519" (with or without an extension), or any path segment
// exactly "secrets". The comparison is case-folded so a shouted
// "ID_RSA"/"SERVER.PEM" is flagged too — for a risk flag, failing closed is
// the only useful bias.
func protectedPath(p string) bool {
	norm := strings.ReplaceAll(p, `\`, "/")
	base := path.Base(norm)
	if base == ".env" || strings.HasPrefix(base, ".env.") {
		return true
	}
	ext := path.Ext(base)
	switch strings.ToLower(ext) {
	case ".pem", ".key", ".crt", ".p12":
		return true
	}
	stem := strings.TrimSuffix(base, ext)
	if strings.EqualFold(stem, "id_rsa") || strings.EqualFold(stem, "id_ed25519") {
		return true
	}
	for _, segment := range strings.Split(norm, "/") {
		if segment == "secrets" {
			return true
		}
	}
	return false
}
