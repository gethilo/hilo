+        // Every remote reference — `Mod:fun(Args)`, `fun Mod:fun/2`,
+        // `Mod:type()` in a spec — is a `remote` node whose qualifier is a
+        // `remote_module`; its `module` field is the module expression.
+        "remote_module" => {
+            let mut cursor = node.walk();
+            let modules: Vec<Node> = node.children_by_field_name("module", &mut cursor).collect();
+            if let Some(module) = erlang_module_atom(&modules, source) {
+                refs.push_module(&module);
+            }
+            return;
+        }
+        _ => {}
